package {
    default_applicable_licenses: ["external_llama_cpp_license"],
}

license {
    name: "external_llama_cpp_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-MIT"],
    license_text: ["LICENSE"],
}

genrule {
    name: "llama_ggml_version_header",
    srcs: ["ggml/src/ggml-version.h.in"],
    out: ["ggml-version.h"],
    cmd: "sed -e 's/@GGML_VERSION@/0.25.3/g' " +
        "-e 's/@GGML_BUILD_COMMIT@/8e16421/g' $(in) > $(out)",
}

genrule {
    name: "llama_version_header",
    srcs: ["src/llama-version.h.in"],
    out: ["llama-version.h"],
    cmd: "sed -e 's/@LLAMA_VERSION@/0.5.0-dev/g' " +
        "-e 's/@LLAMA_BUILD_COMMIT@/8e16421/g' $(in) > $(out)",
}

cc_defaults {
    name: "llama_cpp_defaults",
    sdk_version: "31",
    stl: "c++_static",
    rtti: true,
    compile_multilib: "64",

    cflags: [
        "-O3",
        "-DNDEBUG",
        "-D_XOPEN_SOURCE=600",
        "-D_GNU_SOURCE",
        "-DGGML_USE_CPU",
        "-DGGML_USE_CPU_REPACK",
        "-DGGML_USE_LLAMAFILE",
        "-DGGML_SCHED_MAX_COPIES=1",
        "-fvisibility=hidden",
        "-ffunction-sections",
        "-fdata-sections",
        "-Wno-unused-function",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-unused-but-set-variable",
        "-Wno-missing-field-initializers",
        "-Wno-sign-compare",
        "-Wno-implicit-fallthrough",
        "-Wno-format",
        "-Wno-format-nonliteral",
        "-Wno-macro-redefined",
        "-Wno-deprecated-declarations",
        "-Wno-c99-designator",
        "-Wno-unreachable-code-loop-increment",
        "-Wno-pessimizing-move",
        "-Wno-unqualified-std-cast-call",
    ],

    cppflags: [
        "-std=c++17",
        "-fexceptions",
    ],

    conlyflags: [
        "-std=c11",
    ],

    generated_headers: ["llama_ggml_version_header", "llama_version_header"],

    local_include_dirs: [
        "ggml/include",
        "ggml/src",
        "ggml/src/ggml-cpu",
        "include",
        "src",
    ],

    // We only ship arm64 devices
    enabled: false,
    target: {
        android_arm64: {
            enabled: true,
        },
    },
}

cc_defaults {
    name: "llama_cpp_arm64_defaults",
    defaults: ["llama_cpp_defaults"],
    arch: {
        arm64: {
            cflags: [
                "-march=armv8.2-a+dotprod+fp16",
            ],
        },
    },
}

cc_defaults {
    name: "llama_cpp_i8mm_defaults",
    defaults: ["llama_cpp_defaults"],
    arch: {
        arm64: {
            cflags: [
                "-march=armv8.2-a+dotprod+fp16+i8mm",
            ],
        },
    },
}

// A separate module prevents same-stem C and C++ sources from claiming one Soong object.
cc_library_static {
    name: "libggml_c",
    defaults: ["llama_cpp_arm64_defaults"],

    srcs: [
        "ggml/src/*.c",
        "ggml/src/ggml-cpu/*.c",
        "ggml/src/ggml-cpu/arch/arm/*.c",
    ],
}

cc_library_static {
    name: "libllama_static",
    defaults: ["llama_cpp_arm64_defaults"],

    srcs: [
        "ggml/src/*.cpp",
        "ggml/src/ggml-cpu/*.cpp",
        "ggml/src/ggml-cpu/arch/arm/*.cpp",
        "ggml/src/ggml-cpu/amx/*.cpp",
        "ggml/src/ggml-cpu/llamafile/*.cpp",
        "ggml/src/ggml-cpu/tiled/*.cpp",
        "src/*.cpp",
        "src/models/*.cpp",
    ],

    exclude_srcs: [
        // Feature scoring is only used by dynamically loaded CPU variants.
        "ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp",
    ],

    whole_static_libs: ["libggml_c"],

    export_include_dirs: [
        "ggml/include",
        "include",
    ],
}

cc_library_static {
    name: "libggml_c_i8mm",
    defaults: ["llama_cpp_i8mm_defaults"],

    srcs: [
        "ggml/src/*.c",
        "ggml/src/ggml-cpu/*.c",
        "ggml/src/ggml-cpu/arch/arm/*.c",
    ],
}

cc_library_static {
    name: "libllama_static_i8mm",
    defaults: ["llama_cpp_i8mm_defaults"],

    srcs: [
        "ggml/src/*.cpp",
        "ggml/src/ggml-cpu/*.cpp",
        "ggml/src/ggml-cpu/arch/arm/*.cpp",
        "ggml/src/ggml-cpu/amx/*.cpp",
        "ggml/src/ggml-cpu/llamafile/*.cpp",
        "ggml/src/ggml-cpu/tiled/*.cpp",
        "src/*.cpp",
        "src/models/*.cpp",
    ],

    exclude_srcs: [
        // Feature scoring is only used by dynamically loaded CPU variants.
        "ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp",
    ],

    whole_static_libs: ["libggml_c_i8mm"],

    export_include_dirs: [
        "ggml/include",
        "include",
    ],
}
